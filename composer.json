            "Kontor\\Inventory\\Migrations\\": "packages/inventory/migrations/",
            "Kontor\\Invoices\\": "packages/invoices/src/",
            "Kontor\\Invoices\\Migrations\\": "packages/invoices/migrations/",
            "Kontor\\Ledger\\": "packages/ledger/src/",
            "Kontor\\Ledger\\Migrations\\": "packages/ledger/migrations/",
            "Kontor\\Mail\\": "packages/mail/src/",
            "Kontor\\Mail\\Migrations\\": "packages/mail/migrations/",
            "Kontor\\Marketplace\\": "packages/marketplace/src/",
            "Kontor\\Marketplace\\Migrations\\": "packages/marketplace/migrations/",
            "Kontor\\MCP\\": "packages/mcp/src/",
            "Kontor\\Payments\\": "packages/payments/src/",
            "Kontor\\Payments\\Migrations\\": "packages/payments/migrations/",
            "Kontor\\Portal\\": "packages/portal/src/",
            "Kontor\\Portal\\Migrations\\": "packages/portal/migrations/",
            "Kontor\\Projects\\": "packages/projects/src/",
            "Kontor\\Projects\\Migrations\\": "packages/projects/migrations/",
            "Kontor\\Purchasing\\": "packages/purchasing/src/",
