{
    "name": "kontor/core",
    "description": "Kontor Core: service container, capability/component registries, migrations, audit and the ProcessKontor admin shell for ProcessWire.",
    "type": "library",
    "license": "MIT",
    "version": "1.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1",
        "kontor/sdk": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/sdk"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Core\\": "src/",
            "Kontor\\Core\\Migrations\\": "migrations/",
            "Kontor\\AI\\": "packages/ai/src/",
            "Kontor\\AI\\Migrations\\": "packages/ai/migrations/",
            "Kontor\\API\\": "packages/api/src/",
            "Kontor\\API\\Migrations\\": "packages/api/migrations/",
            "Kontor\\Automation\\": "packages/automation/src/",
            "Kontor\\Automation\\Migrations\\": "packages/automation/migrations/",
            "Kontor\\Cache\\": "packages/cache/src/",
            "Kontor\\Catalog\\": "packages/catalog/src/",
            "Kontor\\Catalog\\Migrations\\": "packages/catalog/migrations/",
            "Kontor\\Collaboration\\": "packages/collaboration/src/",
            "Kontor\\Collaboration\\Migrations\\": "packages/collaboration/migrations/",
            "Kontor\\Contacts\\": "packages/contacts/src/",
            "Kontor\\Contacts\\Migrations\\": "packages/contacts/migrations/",
            "Kontor\\CRM\\": "packages/crm/src/",
            "Kontor\\CRM\\Migrations\\": "packages/crm/migrations/",
            "Kontor\\CRMIntake\\": "packages/crm-intake/src/",
