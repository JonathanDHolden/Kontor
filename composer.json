            "Kontor\\Dashboard\\": "packages/dashboard/src/",
            "Kontor\\Dashboard\\Migrations\\": "packages/dashboard/migrations/",
            "Kontor\\Documents\\": "packages/documents/src/",
            "Kontor\\Documents\\Migrations\\": "packages/documents/migrations/",
            "Kontor\\Demo\\": "packages/demo/src/",
            "Kontor\\Demo\\Migrations\\": "packages/demo/migrations/",
            "Kontor\\Entities\\": "packages/entities/src/",
            "Kontor\\Entities\\Migrations\\": "packages/entities/migrations/",
            "Kontor\\Expenses\\": "packages/expenses/src/",
            "Kontor\\Expenses\\Migrations\\": "packages/expenses/migrations/",
            "Kontor\\Files\\": "packages/files/src/",
            "Kontor\\Files\\Migrations\\": "packages/files/migrations/",
            "Kontor\\Germany\\": "packages/germany/src/",
