            "Kontor\\Queue\\": "packages/queue/src/",
            "Kontor\\Queue\\Migrations\\": "packages/queue/migrations/",
            "Kontor\\Reports\\": "packages/reports/src/",
            "Kontor\\Reports\\Migrations\\": "packages/reports/migrations/",
            "Kontor\\Sales\\": "packages/sales/src/",
            "Kontor\\Sales\\Migrations\\": "packages/sales/migrations/",
            "Kontor\\Search\\": "packages/search/src/",
            "Kontor\\Settings\\": "packages/settings/src/",
            "Kontor\\Tasks\\": "packages/tasks/src/",
            "Kontor\\Tasks\\Migrations\\": "packages/tasks/migrations/",
            "Kontor\\Workflow\\": "packages/workflow/src/",
            "Kontor\\Workflow\\Migrations\\": "packages/workflow/migrations/"
