{
    "name": "kontor/mcp",
    "description": "Scoped MCP Server integration for Kontor business operations.",
    "version": "1.0.1",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Maxim Semenov", "homepage": "https://github.com/mxmsmnv"}],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0",
        "kontor/api": "^1.0"
    },
    "repositories": [
        {
            "name": "monorepo",
            "type": "path",
            "url": "../*"
        },
        {"type": "path", "url": "../sdk"},
        {"type": "path", "url": "../api"},
        {"type": "path", "url": "../.."}
    ],
    "autoload": {"psr-4": {"Kontor\\MCP\\": "src/"}},
    "autoload-dev": {"psr-4": {"Kontor\\MCP\\Tests\\": "tests/"}},
    "minimum-stability": "stable"
}
